{
  "name": "hongguo-downloader",
  "version": "6.4.0",
  "description": "红果短剧播放与下载",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder --win --x64 --publish never",
    "build:zip": "npm run build:react && electron-builder --win --x64 --publish never --dir && node scripts/make-zip.js",
    "build:dir": "npm run build:react && electron-builder --win --x64 --publish never --dir",
    "build:portable": "npm run build:react && electron-builder --win portable --x64 --publish never",
    "build:installer": "npm run build:react && electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --dir",
    "zip": "node scripts/make-zip.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg-mac.js",
    "build:mac": "node scripts/setup-ffmpeg-mac.js arm64 x64 && npm run build:react && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "build:mac:dir": "node scripts/setup-ffmpeg-mac.js arm64 x64 && npm run build:react && electron-builder --mac --arm64 --x64 --dir --publish never",
    "test": "node scripts/test.cjs"
  },
  "dependencies": {
    "anime4k-webgpu": "1.0.0",
    "axios": "1.20.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "js-yaml": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.7.4",
    "vite": "^6.4.5",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "joi": "^17.13.9",
    "source-map-js": "1.2.2",
    "app-builder-lib": {
      "minimatch": "^11.0.5",
      "@electron/asar": {
        "minimatch": "3.1.5",
        "glob": {
          "minimatch": "3.1.5"
        }
      },
      "ejs": {
        "jake": {
          "filelist": {
            "minimatch": "5.1.9"
          }
        }
      }
    },
    "@electron/universal": {
      "minimatch": "^11.0.5",
      "dir-compare": {
        "minimatch": "3.1.5"
      }
    }
  },
  "build": {
    "appId": "io.github.jackotom.hongguo-drama-mac",
    "productName": "红果短剧",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js",
      "build/icon.ico"
    ],
    "asar": true,
    "artifactName": "hongguo-downloader-6.4-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "WINDOWS-*.txt",
            "COPYING.*",
            "LICENSE.md"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-6.4-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果短剧下载器",
      "artifactName": "hongguo-downloader-6.4-win-x64-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "COPYING.*",
            "LICENSE.md",
            "MACOS-*.txt"
          ]
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        },
        {
          "from": "build/app-update.yml",
          "to": "app-update.yml"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/ffprobe"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "yuchen0x1",
      "repo": "HongGuo-PC"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
